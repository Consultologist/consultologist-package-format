{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "specVersion": {
      "type": "integer",
      "const": 7
    },
    "templating": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "const": "scriban"
        },
        "engineVersion": {
          "type": "string",
          "pattern": "^\\d\u002B(\\.\\d\u002B){1,3}$"
        }
      },
      "required": [
        "engine",
        "engineVersion"
      ],
      "additionalProperties": false
    },
    "preludes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prelude": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "file",
          "variables"
        ],
        "additionalProperties": false
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(input|item|data|node):.\u002B$"
                },
                {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^(input|item|data|node):.\u002B$"
                    },
                    "as": {
                      "enum": [
                        "concept-bullets",
                        "concept-context"
                      ]
                    }
                  },
                  "required": [
                    "from"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "output": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string"
              },
              "failIfEmpty": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "schema"
            ],
            "additionalProperties": false
          },
          "forEach": {
            "type": "string",
            "pattern": "^data:.\u002B$"
          },
          "aggregate": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^node:.\u002B$"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "derivedFrom": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*){0,3}@v\\d{4}\\.(0[1-9]|1[0-2])\\.[1-9]\\d*$"
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "pattern": "^node:.\u002B$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "node": {
            "type": "string",
            "pattern": "^node:.\u002B$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "node",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "name",
    "version",
    "specVersion",
    "templating",
    "nodes",
    "inputs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consultologist workflow package manifest, specVersion 7",
  "oneOf": [
    {
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "results"
        ]
      }
    },
    {
      "required": [
        "results"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ],
  "additionalProperties": false
}
