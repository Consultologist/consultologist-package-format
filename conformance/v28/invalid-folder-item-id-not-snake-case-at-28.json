{
  "id": "invalid-folder-item-id-not-snake-case-at-28",
  "specVersion": 28,
  "description": "A snippet folder item whose id has a capital \u2014 the 26 gap closed.",
  "expect": {
    "valid": false,
    "errors": [
      "Snippet folder \u0027sections\u0027 item id \u0027Plan\u0027 must be snake_case (a lowercase letter, then lowercase letters, digits, or underscores)."
    ],
    "warnings": []
  },
  "manifest": {
    "name": "general",
    "version": "v2026.08.1",
    "specVersion": 28,
    "templating": {
      "engine": "scriban",
      "engineVersion": "7.2.5"
    },
    "nodes": [
      {
        "id": "extract",
        "label": "Extract concepts",
        "format": "concept_list",
        "onInvalid": "fail"
      },
      {
        "id": "scope",
        "label": "Scope",
        "format": "classification",
        "with": {
          "values": [
            "in_scope",
            "out_of_scope"
          ]
        },
        "onInvalid": "fail"
      },
      {
        "id": "assessment",
        "label": "Assessment",
        "macros": [
          {
            "id": "closing",
            "at": "after"
          }
        ],
        "format": "prose"
      },
      {
        "id": "section_notes",
        "label": "Section notes",
        "format": "prose"
      },
      {
        "id": "coverage",
        "label": "Coverage",
        "format": "terms_subset",
        "with": {
          "of": "node.extract",
          "in": "node.extract",
          "failWith": "The note names problems the source does not."
        },
        "onInvalid": "fail"
      },
      {
        "id": "sections",
        "label": "Sections",
        "for": "item in snippet.sections",
        "nodes": [
          "section_notes"
        ],
        "ret": "node.section_notes"
      }
    ],
    "inputs": [
      {
        "id": "notes",
        "label": "Referral notes",
        "required": true
      },
      {
        "id": "kind",
        "label": "Kind",
        "required": true,
        "type": "enum",
        "values": [
          "new",
          "follow_up"
        ]
      }
    ],
    "tags": [],
    "macros": [
      "closing"
    ],
    "deliverables": [
      {
        "id": "consult",
        "label": "Consultation note",
        "check": "node.coverage",
        "sources": [
          "node.assessment",
          "node.sections"
        ]
      }
    ],
    "snippets": [
      "standards",
      "sections/"
    ]
  },
  "files": {
    "prompts/assessment.md": "Assess.\n{{ snippet.standards.content }}\n{{ input.notes }}\n{{ for c in node.extract.value.concepts }}- {{ c }}\n{{ end }}",
    "prompts/extract.md": "Extract the concepts from:\n{{ input.notes }}",
    "prompts/scope.md": "Is this in scope? {{ input.notes }}",
    "snippets/sections/Plan.md": "{\n  \u0022label\u0022: \u0022Plan\u0022\n}\nPlan.",
    "snippets/standards.md": "{\n  \u0022label\u0022: \u0022Local standards\u0022\n}\nFollow the local standards.",
    "snippets/sections/index.json": "{ \u0022items\u0022: [\u0022hpi\u0022, \u0022Plan\u0022] }",
    "snippets/sections/hpi.md": "{\n  \u0022label\u0022: \u0022HPI\u0022\n}\nHistory: {{ input.notes }}",
    "macros/closing.md": "{\n  \u0022label\u0022: \u0022Closing\u0022,\n  \u0022instruction\u0022: \u0022Add a closing line if the plan changed.\u0022\n}\nClosing: {{ profile.name }}.",
    "prompts/section_notes.md": "{{ item.label }}: {{ item.content }}"
  }
}