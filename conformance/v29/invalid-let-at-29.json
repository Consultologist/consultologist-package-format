{
  "id": "invalid-let-at-29",
  "specVersion": 29,
  "description": "A let at 29 \u2014 it requires specVersion 30.",
  "expect": {
    "valid": false,
    "errors": [
      "Node \u0027find_problems\u0027 has no prompt: prompts/find_problems.md is missing from the package.",
      "Node \u0027find_problems\u0027 declares let, which requires specVersion 30."
    ],
    "warnings": [
      "prompts/find_problems.md names no node; at specVersion 28 a prompt file is prompts/\u003Cnode id\u003E.md."
    ]
  },
  "manifest": {
    "name": "general",
    "version": "v2026.08.1",
    "specVersion": 29,
    "templating": {
