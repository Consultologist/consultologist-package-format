        },
        "onInvalid": "fail"
      },
      {
        "id": "sections",
        "label": "Sections",
        "for": "item in snippet.sections",
        "nodes": [
          "section_notes"
        ],
        "ret": "node.section_notes"
      },
      {
        "id": "find_problems",
        "label": "Find problems",
        "format": "problem_list",
        "onInvalid": "fail",
