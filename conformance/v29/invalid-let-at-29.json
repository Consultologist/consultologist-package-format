        "id": "problem_list",
        "file": "formats/problem_list.json"
      }
    ]
  },
  "files": {
    "prompts/assessment.md": "Assess.\n{{ snippet.standards.content }}\n{{ input.notes }}\n{{ for c in node.extract.value.concepts }}- {{ c }}\n{{ end }}",
    "prompts/extract.md": "Extract the concepts from:\n{{ input.notes }}",
    "prompts/scope.md": "Is this in scope? {{ input.notes }}",
    "formats/problem_list.json": "{ \u0022type\u0022: \u0022object\u0022, \u0022producer\u0022: \u0022custom\u0022, \u0022outputMacros\u0022: false,\n  \u0022description\u0022: \u0022The problems a referral names.\u0022,\n  \u0022schema\u0022: { \u0022type\u0022: \u0022object\u0022, \u0022additionalProperties\u0022: false, \u0022required\u0022: [\u0022problems\u0022, \u0022summary\u0022],\n              \u0022properties\u0022: {\n                \u0022summary\u0022: { \u0022type\u0022: \u0022string\u0022 },\n                \u0022problems\u0022: { \u0022type\u0022: \u0022array\u0022, \u0022items\u0022: { \u0022type\u0022: \u0022object\u0022, \u0022additionalProperties\u0022: false, \u0022required\u0022: [\u0022name\u0022, \u0022severity\u0022],\n                                                          \u0022properties\u0022: { \u0022name\u0022: { \u0022type\u0022: \u0022string\u0022 },\n                                                                          \u0022severity\u0022: { \u0022type\u0022: \u0022string\u0022, \u0022enum\u0022: [\u0022low\u0022, \u0022high\u0022] } } } } } } }",
    "snippets/standards.md": "{\n  \u0022label\u0022: \u0022Local standards\u0022\n}\nFollow the local standards.",
    "snippets/sections/index.json": "{ \u0022items\u0022: [\u0022hpi\u0022, \u0022plan\u0022] }",
    "snippets/sections/hpi.md": "{\n  \u0022label\u0022: \u0022HPI\u0022\n}\nHistory: {{ input.notes }}",
    "snippets/sections/plan.md": "{\n  \u0022label\u0022: \u0022Plan\u0022\n}\nPlan.",
    "macros/closing.md": "{\n  \u0022label\u0022: \u0022Closing\u0022,\n  \u0022instruction\u0022: \u0022Add a closing line if the plan changed.\u0022\n}\nClosing: {{ profile.name }}.",
    "prompts/section_notes.md": "{{ item.label }}: {{ item.content }}",
    "prompts/find_problems.md": "List the problems this referral names: {{ input.notes }}",
