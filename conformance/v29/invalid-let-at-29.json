      "engineVersion": "7.2.5"
    },
    "nodes": [
      {
        "id": "extract",
        "label": "Extract concepts",
        "format": "concept_list",
        "onInvalid": "fail"
      },
      {
        "id": "scope",
        "label": "Scope",
        "format": "classification",
        "with": {
          "values": [
            "in_scope",
            "out_of_scope"
          ]
        },
        "onInvalid": "fail"
      },
      {
        "id": "assessment",
        "label": "Assessment",
        "macros": [
          {
            "id": "closing",
            "at": "after"
          }
        ],
        "format": "prose"
      },
      {
        "id": "section_notes",
        "label": "Section notes",
        "format": "prose"
      },
      {
        "id": "coverage",
        "label": "Coverage",
        "format": "terms_subset",
        "with": {
