      },
      {
        "id": "draft_problem",
        "label": "Draft problem",
        "format": "prose"
      },
      {
        "id": "problems",
        "label": "Problems",
        "for": "item in node.find_problems.value.problems",
        "nodes": [
          "draft_problem"
        ],
        "ret": "node.draft_problem"
      }
    ],
    "inputs": [
      {
        "id": "notes",
        "label": "Referral notes",
        "required": true
      },
      {
        "id": "kind",
        "label": "Kind",
        "required": true,
        "type": "enum",
        "values": [
          "new",
          "follow_up"
        ]
      }
    ],
    "tags": [],
    "macros": [
      "closing"
    ],
    "deliverables": [
      {
        "id": "consult",
        "label": "Consultation note",
        "check": "node.coverage",
        "sources": [
          "node.assessment",
          "node.sections",
          "node.problems"
        ]
      }
    ],
    "snippets": [
      "standards",
      "sections/"
    ],
    "formats": [
