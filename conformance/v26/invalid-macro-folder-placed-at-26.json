{
  "id": "invalid-macro-folder-placed-at-26",
  "specVersion": 26,
  "description": "A macro folder placed on a node \u2014 a folder is read, not placed.",
  "expect": {
    "valid": false,
    "errors": [
      "Node \u0027assessment\u0027 macro \u0027section_notes\u0027 names macro folder \u0027section_notes\u0027; a folder is read ({{ for m in macro.section_notes }}), not placed, at specVersion 26."
    ],
    "warnings": []
  },
  "manifest": {
    "name": "general",
    "version": "v2026.08.1",
    "specVersion": 26,
    "templating": {
      "engine": "scriban",
      "engineVersion": "7.2.5"
    },
    "nodes": [
      {
        "id": "extract",
        "label": "Extract concepts",
        "prompt": "prompts/extract.md",
        "format": "concept_list",
        "onInvalid": "fail"
      },
      {
        "id": "scope",
        "label": "Scope",
        "prompt": "prompts/scope.md",
        "format": "classification",
        "with": {
          "values": [
            "in_scope",
            "out_of_scope"
          ]
        },
        "onInvalid": "fail"
      },
      {
        "id": "assessment",
        "label": "Assessment",
        "prompt": "prompts/assessment.md",
        "macros": [
          {
            "id": "closing",
            "at": "after"
          },
          {
            "id": "section_notes",
            "at": "after"
          }
        ],
        "format": "prose"
      },
      {
        "id": "section_notes",
        "label": "Section notes",
        "prompt": "prompts/section.md",
        "format": "prose"
      },
      {
        "id": "coverage",
        "label": "Coverage",
        "format": "terms_subset",
        "with": {
          "of": "node.extract",
          "in": "node.extract",
          "failWith": "The note names problems the source does not."
        },
        "onInvalid": "fail"
      },
      {
        "id": "sections",
        "label": "Sections",
        "for": "item in snippet.sections",
        "nodes": [
          "section_notes"
        ],
        "ret": "node.section_notes"
      }
    ],
    "inputs": [
      {
        "id": "notes",
        "label": "Referral notes",
        "required": true
      },
      {
        "id": "kind",
        "label": "Kind",
        "required": true,
        "type": "enum",
        "values": [
          "new",
          "follow_up"
        ]
      }
    ],
    "tags": [],
    "macros": {
      "closing": "macros/closing.md",
      "section_notes": "macros/section_notes/"
    },
    "deliverables": [
      {
        "id": "consult",
        "label": "Consultation note",
        "check": "node.coverage",
        "sources": [
          "node.assessment",
          "node.sections"
        ]
      }
    ],
    "snippets": {
      "standards": "snippets/standards.md",
      "sections": "snippets/sections/"
    }
  },
  "files": {
    "prompts/assessment.md": "Assess. {{ for m in macro.section_notes }}{{ m.label }}: {{ m.prompt }}{{ end }}",
    "prompts/extract.md": "Extract the concepts from:\n{{ input.notes }}",
    "prompts/scope.md": "Is this in scope? {{ input.notes }}",
    "prompts/section.md": "{{ item.label }}: {{ item.content }}",
    "snippets/standards.md": "{\n  \u0022label\u0022: \u0022Local standards\u0022\n}\nFollow the local standards.",
    "snippets/sections/index.json": "[ { \u0022id\u0022: \u0022hpi\u0022, \u0022file\u0022: \u0022hpi.md\u0022 }, { \u0022id\u0022: \u0022plan\u0022, \u0022file\u0022: \u0022plan.md\u0022 } ]",
    "snippets/sections/hpi.md": "{\n  \u0022label\u0022: \u0022HPI\u0022\n}\nHistory: {{ input.notes }}",
    "snippets/sections/plan.md": "{\n  \u0022label\u0022: \u0022Plan\u0022\n}\nPlan.",
    "macros/closing.md": "{\n  \u0022label\u0022: \u0022Closing\u0022,\n  \u0022instruction\u0022: \u0022Add a closing line if the plan changed.\u0022\n}\nClosing: {{ profile.name }}.",
    "macros/section_notes/index.json": "[ { \u0022id\u0022: \u0022hpi\u0022, \u0022file\u0022: \u0022hpi.md\u0022 }, { \u0022id\u0022: \u0022plan\u0022, \u0022file\u0022: \u0022plan.md\u0022 } ]",
    "macros/section_notes/hpi.md": "{\n  \u0022label\u0022: \u0022HPI notes\u0022,\n  \u0022instruction\u0022: \u0022Note the history.\u0022\n}\nHistory noted: {{ profile.name }}.",
    "macros/section_notes/plan.md": "{\n  \u0022label\u0022: \u0022Plan notes\u0022,\n  \u0022instruction\u0022: \u0022Note the plan.\u0022\n}\nPlan noted."
  }
}