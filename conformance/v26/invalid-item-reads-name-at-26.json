{
  "id": "invalid-item-reads-name-at-26",
  "specVersion": 26,
  "description": "A body node reading item.name \u2014 at 26 the member is .label.",
  "expect": {
    "valid": false,
    "errors": [
      "Node \u0027section_notes\u0027 prompt reads item.name; at specVersion 26 the member is .label."
    ],
    "warnings": []
  },
  "manifest": {
    "name": "general",
    "version": "v2026.08.1",
    "specVersion": 26,
    "templating": {
