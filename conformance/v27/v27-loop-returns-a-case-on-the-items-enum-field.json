{
  "id": "v27-loop-returns-a-case-on-the-items-enum-field",
  "specVersion": 27,
  "description": "A loop over an array input of objects whose body is a case node switching on the item\u0027s enum field (item.value.kind), one branch per value; the loop returns it.",
  "expect": {
    "valid": true,
    "errors": [],
    "warnings": []
  },
  "manifest": {
    "name": "general",
    "version": "v2026.08.1",
    "specVersion": 27,
    "templating": {
      "engine": "scriban",
      "engineVersion": "7.2.5"
    },
    "nodes": [
      {
        "id": "extract",
        "label": "Extract concepts",
        "prompt": "prompts/extract.md",
        "format": "concept_list",
        "onInvalid": "fail"
      },
      {
        "id": "scope",
        "label": "Scope",
        "prompt": "prompts/scope.md",
        "format": "classification",
        "with": {
          "values": [
            "in_scope",
            "out_of_scope"
          ]
        },
        "onInvalid": "fail"
      },
      {
        "id": "assessment",
        "label": "Assessment",
        "prompt": "prompts/assessment.md",
        "macros": [
          {
            "id": "closing",
            "at": "after"
          }
        ],
        "format": "prose"
      },
      {
        "id": "section_notes",
        "label": "Section notes",
        "prompt": "prompts/section.md",
        "format": "prose"
      },
      {
        "id": "coverage",
        "label": "Coverage",
        "format": "terms_subset",
        "with": {
          "of": "node.extract",
          "in": "node.extract",
          "failWith": "The note names problems the source does not."
        },
        "onInvalid": "fail"
      },
      {
        "id": "sections",
        "label": "Sections",
        "for": "item in snippet.sections",
        "nodes": [
          "section_notes"
        ],
        "ret": "node.section_notes"
      },
      {
        "id": "plan",
        "label": "Plan",
        "prompt": "prompts/plan.md",
        "format": "prose"
      },
      {
        "id": "letter",
        "label": "Letter",
        "prompt": "prompts/letter.md",
        "format": "prose"
      },
      {
        "id": "route",
        "label": "Route",
        "case": "item.value.kind",
        "branches": [
          {
            "when": [
              "narrative"
            ],
            "nodes": [
              "plan"
            ],
            "ret": "node.plan"
          },
          {
            "when": [
              "table"
            ],
            "nodes": [
              "letter"
            ],
            "ret": "node.letter"
          }
        ]
      },
      {
        "id": "topic_sections",
        "label": "Topic sections",
        "for": "item in input.topics",
        "nodes": [
          "route"
        ],
        "ret": "node.route"
      }
    ],
    "inputs": [
      {
        "id": "notes",
        "label": "Referral notes",
        "required": true
      },
      {
        "id": "kind",
        "label": "Kind",
        "required": true,
        "type": "enum",
        "values": [
          "new",
          "follow_up"
        ]
      },
      {
        "id": "topics",
        "label": "Topics",
        "required": false,
        "type": "array",
        "items": "object",
        "fields": [
          {
            "id": "title",
            "label": "Title",
            "required": true,
            "type": "text"
          },
          {
            "id": "kind",
            "label": "Kind",
            "required": true,
            "type": "enum",
            "values": [
              "narrative",
              "table"
            ]
          }
        ]
      }
    ],
    "tags": [],
    "macros": {
      "closing": "macros/closing.md"
    },
    "deliverables": [
      {
        "id": "consult",
        "label": "Consultation note",
        "check": "node.coverage",
        "sources": [
          "node.assessment",
          "node.sections",
          "node.topic_sections"
        ]
      }
    ],
    "snippets": {
      "standards": "snippets/standards.md",
      "sections": "snippets/sections/"
    }
  },
  "files": {
    "prompts/assessment.md": "Assess.\n{{ snippet.standards.content }}\n{{ input.notes }}\n{{ for c in node.extract.value.concepts }}- {{ c }}\n{{ end }}",
    "prompts/extract.md": "Extract the concepts from:\n{{ input.notes }}",
    "prompts/scope.md": "Is this in scope? {{ input.notes }}",
    "prompts/section.md": "{{ item.label }}: {{ item.content }}",
    "snippets/standards.md": "{\n  \u0022label\u0022: \u0022Local standards\u0022\n}\nFollow the local standards.",
    "snippets/sections/index.json": "[ { \u0022id\u0022: \u0022hpi\u0022, \u0022file\u0022: \u0022hpi.md\u0022 }, { \u0022id\u0022: \u0022plan\u0022, \u0022file\u0022: \u0022plan.md\u0022 } ]",
    "snippets/sections/hpi.md": "{\n  \u0022label\u0022: \u0022HPI\u0022\n}\nHistory: {{ input.notes }}",
    "snippets/sections/plan.md": "{\n  \u0022label\u0022: \u0022Plan\u0022\n}\nPlan.",
    "macros/closing.md": "{\n  \u0022label\u0022: \u0022Closing\u0022,\n  \u0022instruction\u0022: \u0022Add a closing line if the plan changed.\u0022\n}\nClosing: {{ profile.name }}.",
    "prompts/plan.md": "Plan for {{ item.value.title }}.",
    "prompts/letter.md": "Letter about {{ item.value.title }}."
  }
}