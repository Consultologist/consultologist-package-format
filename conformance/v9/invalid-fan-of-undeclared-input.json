{
  "id": "invalid-fan-of-undeclared-input",
  "specVersion": 9,
  "description": "forEach naming an input the manifest does not declare.",
  "expect": {
    "valid": false,
    "errors": [
      "Node \u0027summarise-note\u0027 forEach \u0027input:missing_notes\u0027 fans undeclared input \u0027missing_notes\u0027."
