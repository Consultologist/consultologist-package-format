{
  "id": "v25-placed-and-inline-macros",
  "specVersion": 25,
  "description": "The rich case: a deliverable macro prepended under a gate, appended, and a second prepended; failIfEmpty on a text and an array format; the fanned prompt reading the item and the inline macro per item; a rendered node over the prose; an optional array input fanned per event; one aggregator collecting all.",
  "expect": {
    "valid": true,
    "errors": [],
    "warnings": []
  },
  "manifest": {
    "name": "general",
    "version": "v2026.08.1",
    "specVersion": 25,
    "templating": {
      "engine": "scriban",
      "engineVersion": "7.2.5"
    },
    "prompts": [
      {
        "id": "assessment",
        "file": "prompts/assessment.md"
      },
      {
        "id": "extract",
        "file": "prompts/extract.md"
      },
      {
        "id": "scope",
        "file": "prompts/scope.md"
      },
      {
        "id": "section",
        "file": "prompts/section.md"
      },
      {
        "id": "summary",
        "file": "prompts/summary.md"
      },
      {
        "id": "per_event",
        "file": "prompts/per_event.md"
      }
    ],
    "nodes": [
      {
        "id": "extract",
        "label": "Extract concepts",
        "prompt": "extract",
        "format": "concept_list",
        "onInvalid": "fail",
        "failIfEmpty": "No concepts were found."
      },
      {
        "id": "scope",
        "label": "Scope",
        "prompt": "scope",
        "format": "classification",
        "with": {
          "values": [
            "in_scope",
            "out_of_scope"
          ]
        },
        "onInvalid": "fail"
      },
      {
        "id": "assessment",
        "label": "Assessment",
        "prompt": "assessment",
        "macros": [
          {
            "id": "closing",
            "at": "after"
          }
        ],
        "format": "prose",
        "failIfEmpty": "The assessment is empty."
      },
      {
        "id": "section_notes",
        "label": "Section notes",
        "prompt": "section",
        "forEach": "snippet.sections",
        "format": "prose"
      },
      {
        "id": "coverage",
        "label": "Coverage",
        "format": "terms_subset",
        "with": {
          "of": "node.extract",
          "in": "node.extract",
          "failWith": "The note names problems the source does not."
        },
        "onInvalid": "fail"
      },
      {
        "id": "all",
        "label": "Everything",
        "aggregate": [
          "node.assessment",
          "node.section_notes",
          "node.summary",
          "node.per_event"
        ]
      },
      {
        "id": "summary",
        "label": "Summary",
        "prompt": "summary",
        "format": "rendered"
      },
      {
        "id": "per_event",
        "label": "Per event",
        "prompt": "per_event",
        "forEach": "input.history",
        "format": "prose"
      }
    ],
    "inputs": [
      {
        "id": "notes",
        "label": "Referral notes",
        "required": true
      },
      {
        "id": "kind",
        "label": "Kind",
        "required": true,
        "type": "enum",
        "values": [
          "new",
          "follow_up"
        ]
      },
      {
        "id": "history",
        "label": "History",
        "required": false,
        "type": "array",
        "items": "text"
      }
    ],
    "tags": [],
    "macros": [
      {
        "id": "closing",
        "label": "Closing",
        "file": "macros/closing.md",
        "instruction": "Add a closing line if the plan changed."
      },
      {
        "id": "scope_line",
        "label": "Scope line",
        "file": "macros/scope_line.md",
        "instruction": "State the scope once."
      }
    ],
    "deliverables": [
      {
        "id": "consult",
        "node": "node.all",
        "label": "Consultation note",
        "macros": [
          {
            "id": "closing",
            "at": "prepend",
            "when": "input.kind == \u0022follow_up\u0022"
          },
          {
            "id": "closing",
            "at": "append"
          },
          {
            "id": "scope_line",
            "at": "prepend"
          }
        ],
        "check": "node.coverage"
      }
    ],
    "snippets": {
      "standards": "snippets/standards.md",
      "sections": "snippets/sections/"
    }
  },
  "files": {
    "prompts/assessment.md": "Assess.\n{{ snippet.standards.content }}\n{{ input.notes }}\n{{ for c in node.extract.value.concepts }}- {{ c }}\n{{ end }}",
    "prompts/extract.md": "Extract the concepts from:\n{{ input.notes }}",
    "prompts/scope.md": "Is this in scope? {{ input.notes }}",
    "prompts/section.md": "{{ item.name }}: {{ item.content }} {{ macro.closing.prompt }}",
    "snippets/standards.md": "Follow the local standards.",
    "snippets/sections/index.json": "{ \u0022fields\u0022: [\u0022id\u0022, \u0022name\u0022, \u0022content\u0022], \u0022items\u0022: [ { \u0022id\u0022: \u0022hpi\u0022, \u0022name\u0022: \u0022HPI\u0022, \u0022file\u0022: \u0022hpi.md\u0022 }, { \u0022id\u0022: \u0022plan\u0022, \u0022name\u0022: \u0022Plan\u0022, \u0022file\u0022: \u0022plan.md\u0022, \u0022when\u0022: \u0022input.kind == \\\u0022new\\\u0022\u0022 } ] }",
    "snippets/sections/hpi.md": "History: {{ input.notes }}",
    "snippets/sections/plan.md": "Plan.",
    "macros/closing.md": "Closing: {{ profile.name }}.",
    "macros/scope_line.md": "Scope: {{ node.scope.value }}.",
    "prompts/summary.md": "Summary of {{ node.assessment.content }}.",
    "prompts/per_event.md": "Event: {{ item.value }}"
  }
}