{
  "about": "nodes/standing_sections/applies/index.json (part 04 section 5.4).",
  "instance": {
    "kind": "if",
    "producer": "computed",
    "label": "Holding the billing section back unless asked",
    "description": null,
    "format": "plaintext",
    "reproducible": false,
    "modelDerived": true,
    "runDependent": false,
    "profileCarrying": false,
    "if": {
      "or": [
        {
          "!==": [
            {
              "var": "item.id"
            },
            "billing"
          ]
        },
        {
          "===": [
            {
              "var": "input.include_billing.value"
            },
            true
          ]
        }
      ]
    },
    "then": {
      "nodes": [
        "standing_draft"
      ],
      "ret": "node.standing_sections.applies.standing_draft"
    },
    "else": null
  }
}
